# SiliconPath — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER COMMIT .env.local OR ANY FILE WITH REAL SECRETS.
#
# The app runs fully without Supabase credentials (client-side fallbacks
# power all learning content). Configure Supabase only if you want the
# academy progress API routes to persist to a database.

# ─────────────────────────────────────────────────────────────────
# SUPABASE — Academy progress persistence (optional)
# https://supabase.com/dashboard/project/<your-project-ref>
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>

# Server-only (used by src/lib/supabase-admin.ts and API routes)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard--server-only>