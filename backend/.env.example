# ===========================================================================
# SiliconPath backend (Express scraper) environment
# Copy to .env.local and fill in. NEVER commit real values.
# ===========================================================================

# Server
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,https://siliconpath.vercel.app
RATE_LIMIT_MAX=120

# Shared secret to authenticate scrape triggers (MUST match the frontend)
SCRAPER_SECRET=must-match-frontend-value

# Supabase Project 1 (core) — backend writes scraped opportunities here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-1.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers (at least one) for parsing unstructured listings
GROQ_API_KEY=
GEMINI_API_KEY=
