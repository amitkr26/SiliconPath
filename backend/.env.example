# ── Required ──────────────────────────────────────────────────────────────
PORT=3001
SCRAPER_SECRET=change-me-to-a-random-secret

# ── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://siliconpath.vercel.app

# ── Rate limiting (requests per minute per IP) ────────────────────────────
RATE_LIMIT_MAX=120

# ── Database (at least one required for persistence) ──────────────────────
# Supabase (primary: opportunities, news)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (secondary: social)
SUPABASE_2_URL=
SUPABASE_2_SERVICE_ROLE_KEY=

# Neon (analytics)
NEON_1_DATABASE_URL=

# Neon (cache)
NEON_2_DATABASE_URL=
