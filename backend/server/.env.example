# BerojgarDegreeWala backend/server environment
# Categories: REQUIRED (boot needs these), OPTIONAL (provider fallback / dev),
# DEPLOYMENT (runtime behavior). Names only — never commit real values.

# ── REQUIRED ──
# Supabase (same architecture as the Next.js app — DB1 primary)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, never in the browser>
# Auth
ADMIN_PASSWORD=<change-me>
ADMIN_HMAC_SECRET=<change-me>
# Cron (Bearer secret for /api/v1/cron/* — without it the routes reject all)
CRON_SECRET=<change-me>

# ── OPTIONAL ──
# Supabase DB2 (secondary / social layer legacy mirror)
SUPABASE_2_URL=
SUPABASE_2_SERVICE_ROLE_KEY=
# AI providers (same keys the ai-gateway package reads; at least one key for
# AI routes to work — fallback order groq→gemini→openrouter→nvidia→agentrouter
# →omnirouter→cloudflare→bedrock→huggingface)
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=
OPENROUTER_API_KEY=
CLOUDFLARE_AI_TOKEN=
HUGGINGFACE_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=
OMNIROUTER_API_KEY=
OMNIROUTER_BASE_URL=

# ── DEPLOYMENT ──
PORT=8080
NODE_ENV=production
# CORS (comma-separated origins; localhost is always allowed in dev)
ALLOWED_ORIGINS=https://berojgardegreewala.vercel.app,http://localhost:3000