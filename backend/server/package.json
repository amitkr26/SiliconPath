{
  "name": "@berojgardegreewala/server",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone REST backend for BerojgarDegreeWala (parallel to the Next.js internal API). Runs independently on Render.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --import tsx dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@berojgardegreewala/ai-gateway": "1.0.0",
    "@berojgardegreewala/api": "1.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.1.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}