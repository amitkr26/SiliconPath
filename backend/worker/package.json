{
  "name": "@berojgardegreewala/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone scraper worker for the BerojgarDegreeWala backend. Runs on a schedule (Render cron job) and shares all ingestion logic with the server via @berojgardegreewala/api.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --import tsx dist/index.js",
    "start:worker": "node --import tsx dist/index.js news",
    "start:news": "node --import tsx dist/index.js news",
    "start:isro": "node --import tsx dist/index.js isro",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@berojgardegreewala/api": "1.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
