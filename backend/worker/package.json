{
  "name": "@berojgardegreewala/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone scraper worker for BerojgarDegreeWala. Runs independently of the Express server and Next.js frontend.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --import tsx dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^16.4.5",
    "rss-parser": "^3.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
