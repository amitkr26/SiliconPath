# ===========================================================================
# SiliconPath frontend (electrobridge) environment
# Copy to .env.local and fill in. NEVER commit real values.
# Rule: secrets must NOT be prefixed with NEXT_PUBLIC_ (that exposes them to
# the browser bundle).
# ===========================================================================

# --- Supabase Project 1 (core data) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-1.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase Project 2 (user / social data) ---
SUPABASE_2_URL=https://your-project-2.supabase.co
SUPABASE_2_ANON_KEY=your-anon-key-2
SUPABASE_2_SERVICE_ROLE_KEY=your-service-role-key-2

# --- Neon (analytics, single DB) ---
NEON_DATABASE_URL=postgresql://user:pass@ep-name.region.aws.neon.tech/neondb

# --- Admin & cron auth (SERVER-ONLY, no NEXT_PUBLIC_) ---
ADMIN_PASSWORD=generate-a-strong-random-string
CRON_SECRET=generate-another-strong-random-string

# --- Backend integration ---
RENDER_BACKEND_URL=https://siliconpath-backend.onrender.com
SCRAPER_SECRET=must-match-backend-value

# --- Durable rate limiting (required in production) ---
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- AI providers (at least one) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=noreply@siliconpath.vercel.app

# --- Misc ---
NEXT_PUBLIC_SITE_URL=https://siliconpath.vercel.app
NEXT_PUBLIC_SENTRY_DSN=
