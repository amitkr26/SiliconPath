# ���������������������������������������������������������������������������������������������������������������������������������������
# BerojgarDegreeWala — Frontend Environment Variables
# ���������������������������������������������������������������������������������������������������������������������������������������
# COPY THIS FILE TO .env.local AND FILL IN REAL VALUES
# NEVER COMMIT .env.local OR ANY FILE WITH REAL SECRETS
# ���������������������������������������������������������������������������������������������������������������������������������������

# ─────────────────────────────────────────────────────────────────
# BDW AI — Career Intelligence Engine (optional, provider #1 when enabled)
# Any OpenAI-compatible endpoint: local inference, cloud GPU, private API.
# Contract: POST {BDW_AI_BASE_URL}/chat/completions (OpenAI chat format),
# response must include choices[0].message.content. See
# project-bible/BDW_MODEL_INTEGRATION.md before activating.
# ─────────────────────────────────────────────────────────────────
BDW_AI_ENABLED=false
BDW_AI_BASE_URL=
BDW_AI_MODEL=bdw-career-ai
BDW_AI_API_KEY=
BDW_AI_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────
# SUPABASE DB1 (Primary) — Core Platform Data
# Project: https://supabase.com/dashboard/project/<your-project-ref>
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard--server-only>

# ─────────────────────────────────────────────────────────────────
# SUPABASE DB2 (Secondary) — User & Social Layer
# Project: https://supabase.com/dashboard/project/<your-project-ref-2>
# ─────────────────────────────────────────────────────────────────
SUPABASE_2_URL=https://<project-ref-2>.supabase.co
SUPABASE_2_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard-2--server-only>
SUPABASE_2_ANON_KEY=<anon-key-from-supabase-dashboard-2>

# ─────────────────────────────────────────────────────────────────
# NEON DATABASES — Analytics, Logs, Search, Cache
# ─────────────────────────────────────────────────────────────────
# Neon DB1: Analytics & Operational Logs
NEON_1_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Neon DB2: Search Acceleration & Cache
NEON_2_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# ─────────────────────────────────────────────────────────────────
# AI PROVIDERS — At least one required for AI features
# ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=<groq-api-key>                    # Primary (Llama-3.1)
GEMINI_API_KEY=<gemini-api-key>                # Google Gemini
NVIDIA_NIM_API_KEY=<nvidia-nim-api-key>        # NVIDIA NIM
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=<openrouter-api-key>        # Fallback gateway
CLOUDFLARE_AI_TOKEN=<cloudflare-workers-ai-token>
HUGGINGFACE_API_KEY=<huggingface-api-key>
AWS_BEARER_TOKEN_BEDROCK=<aws-bedrock-bearer-token>

# ─────────────────────────────────────────────────────────────────
# EMAIL & NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=<resend-api-key>
FROM_EMAIL=notifications@berojgardegreewala.vercel.app
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHANNEL_ID=<telegram-channel-id>

# ─────────────────────────────────────────────────────────────────
# RATE LIMITING & CACHING (Upstash Redis)
# ─────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=<upstash-redis-rest-url>
UPSTASH_REDIS_REST_TOKEN=<upstash-redis-rest-token>

# ─────────────────────────────────────────────────────────────────
# CRON & REVALIDATION SECRETS — Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────
CRON_SECRET=<cron-secret>

# ─────────────────────────────────────────────────────────────────
# ADMIN AUTHENTICATION
# ─────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=<admin-password--generate-with-openssl-rand-base64-24>
ADMIN_HMAC_SECRET=<admin-hmac-secret--generate-with-openssl-rand-hex-32>

# ─────────────────────────────────────────────────────────────────
# SITE & OBSERVABILITY
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://berojgardegreewala.vercel.app
NEXT_PUBLIC_SENTRY_DSN=<sentry-dsn-optional>

# ─────────────────────────────────────────────────────────────────
# GOOGLE CLOUD (Resume Parsing + Storage) — Optional
# ─────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_CREDENTIALS_BASE64=<base64-encoded-service-account-json>
GCP_PROJECT_ID=<gcp-project-id>
GCP_DOCUMENT_AI_LOCATION=us
GCP_DOCUMENT_AI_PROCESSOR_ID=<document-ai-processor-id>
GCP_STORAGE_BUCKET_NAME=<gcs-bucket-name>

# ─────────────────────────────────────────────────────────────────
# DEVELOPMENT ONLY
# ─────────────────────────────────────────────────────────────────
# SCRAPER_ALLOW_FABRICATED=true  # Enable fabricated scraping in dev