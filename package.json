{
  "name": "siliconpath",
  "version": "1.0.0",
  "private": true,
  "description": "SiliconPath — 100% free VLSI learning platform: 7 academy tracks, 15 learning paths / 150 modules, embedded NPTEL + YouTube lectures, 55 STA interview questions.",
  "workspaces": [
    "legacy/backend/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean:test-data": "node scripts/delete-fake-jobs.js",
    "legacy:backend:server": "npm run start --workspace @berojgardegreewala/server",
    "legacy:backend:worker": "npm run start:worker --workspace @berojgardegreewala/worker",
    "legacy:backend:test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@google-cloud/documentai": "^9.6.2",
    "@google-cloud/storage": "^7.21.0",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "autoprefixer": "^10.5.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.383.0",
    "mammoth": "^1.12.2",
    "next": "^14.2.21",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "resend": "^6.16.0",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.11.21",
    "@swc/jest": "^0.2.37",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.21",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pg": "^8.22.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  },
  "packageManager": "npm@10.5.0",
  "engines": {
    "node": ">=18"
  }
}