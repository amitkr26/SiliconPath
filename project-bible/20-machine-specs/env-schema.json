{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "BerojgarDegreeWala Environment Variables",
  "description": "Live env var names from code, verified 2026-08-19. Sources: frontend/src/lib/db/index.ts, frontend/src/lib/supabase.ts, frontend/src/lib/ai/*, backend/ai-gateway/src/gateway/index.ts, backend/server/src/config/env.ts, frontend/.env.example.",
  "type": "object",
  "visibility": ["required", "optional", "frontend-public", "backend-only"],
  "required": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_2_URL",
    "SUPABASE_2_SERVICE_ROLE_KEY",
    "NEON_1_DATABASE_URL",
    "NEON_2_DATABASE_URL",
    "CRON_SECRET",
    "ADMIN_PASSWORD"
  ],
  "properties": {
    "NEXT_PUBLIC_SUPABASE_URL": { "type": "string", "format": "uri", "visibility": "required", "exposure": "frontend-public", "description": "Supabase DB1 project URL" },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": { "type": "string", "visibility": "required", "exposure": "frontend-public", "description": "Supabase DB1 anon key" },
    "SUPABASE_SERVICE_ROLE_KEY": { "type": "string", "visibility": "required", "exposure": "backend-only", "description": "Supabase DB1 service role key" },
    "SUPABASE_2_URL": { "type": "string", "format": "uri", "visibility": "required", "exposure": "backend-only", "description": "Supabase DB2 project URL (legacy mirror: news_archive, user_profiles)" },
    "SUPABASE_2_SERVICE_ROLE_KEY": { "type": "string", "visibility": "required", "exposure": "backend-only", "description": "Supabase DB2 service role key" },
    "SUPABASE_2_ANON_KEY": { "type": "string", "visibility": "optional", "exposure": "frontend-public", "description": "Supabase DB2 anon key, used by getDb2Anon" },
    "NEON_1_DATABASE_URL": { "type": "string", "format": "uri", "visibility": "required", "exposure": "backend-only", "description": "Neon 1 connection string (analytics + mirrors)" },
    "NEON_2_DATABASE_URL": { "type": "string", "format": "uri", "visibility": "required", "exposure": "backend-only", "description": "Neon 2 connection string (cache mirror)" },
    "GROQ_API_KEY": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "AI provider: groq (chain position 1)" },
    "GEMINI_API_KEY": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "AI provider: gemini (chain position 2)" },
    "OPENROUTER_API_KEY": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "AI provider: openrouter (chain position 3)" },
    "NVIDIA_NIM_API_KEY": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "AI provider: nvidia (chain position 4)" },
    "NVIDIA_NIM_BASE_URL": { "type": "string", "format": "uri", "visibility": "optional", "exposure": "backend-only", "description": "NVIDIA NIM base URL, default https://integrate.api.nvidia.com/v1" },
    "AGENTROUTER_API_KEY": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "AI provider: agentrouter (chain position 5)" },
    "OMNIROUTER_BASE_URL": { "type": "string", "format": "uri", "visibility": "optional", "exposure": "backend-only", "default": "http://localhost:20128/v1", "description": "AI provider: omnirouter base URL (chain position 6)" },
    "OMNIROUTER_API_KEY": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Optional bearer token for omnirouter" },
    "CLOUDFLARE_AI_TOKEN": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "AI provider: cloudflare Workers AI token (chain position 7)" },
    "CLOUDFLARE_ACCOUNT_ID": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Cloudflare account ID, required with CLOUDFLARE_AI_TOKEN" },
    "HUGGINGFACE_API_KEY": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "AI provider: huggingface (chain position 9)" },
    "AWS_BEARER_TOKEN_BEDROCK": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "AI provider: bedrock bearer token (chain position 8)" },
    "RESEND_API_KEY": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Resend email API key; enables email digests" },
    "FROM_EMAIL": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Sender address for email digests/notifications" },
    "TELEGRAM_BOT_TOKEN": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Telegram bot token; enables telegram notifications" },
    "TELEGRAM_CHANNEL_ID": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Telegram channel id for notifications" },
    "UPSTASH_REDIS_REST_URL": { "type": "string", "format": "uri", "visibility": "optional", "exposure": "backend-only", "description": "Upstash Redis REST URL; falls back to in-memory rate limiting" },
    "UPSTASH_REDIS_REST_TOKEN": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Upstash Redis REST token" },
    "CRON_SECRET": { "type": "string", "visibility": "required", "exposure": "backend-only", "description": "Bearer token for cron endpoints" },
    "ADMIN_PASSWORD": { "type": "string", "visibility": "required", "exposure": "backend-only", "description": "Admin dashboard password; HMAC fallback key" },
    "ADMIN_HMAC_SECRET": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "HMAC secret for admin session tokens; falls back to ADMIN_PASSWORD" },
    "SCRAPER_ALLOW_FABRICATED": { "type": "string", "enum": ["true", "false"], "visibility": "optional", "exposure": "backend-only", "default": "false", "description": "When true, enables fabricated scraper postings (national-scrapers.ts, global-master-scraper.ts). Disabled in production." },
    "NEXT_PUBLIC_SITE_URL": { "type": "string", "format": "uri", "visibility": "optional", "exposure": "frontend-public", "default": "http://localhost:3000", "description": "Canonical site URL" },
    "NEXT_PUBLIC_SENTRY_DSN": { "type": "string", "format": "uri", "visibility": "optional", "exposure": "frontend-public", "description": "Sentry DSN for error monitoring" },
    "GOOGLE_CLOUD_CREDENTIALS_BASE64": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Base64-encoded GCP service account JSON for Document AI + GCS" },
    "GCP_PROJECT_ID": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "GCP project id" },
    "GCP_DOCUMENT_AI_LOCATION": { "type": "string", "visibility": "optional", "exposure": "backend-only", "default": "us", "description": "Document AI processor location" },
    "GCP_DOCUMENT_AI_PROCESSOR_ID": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "Document AI processor id for resume parsing" },
    "GCP_STORAGE_BUCKET_NAME": { "type": "string", "visibility": "optional", "exposure": "backend-only", "description": "GCS bucket for uploads" },
    "PORT": { "type": "integer", "visibility": "optional", "exposure": "backend-only", "default": 8080, "description": "Backend server port" },
    "NODE_ENV": { "type": "string", "enum": ["development", "production", "test"], "visibility": "optional", "exposure": "backend-only", "default": "development", "description": "Backend node environment" },
    "ALLOWED_ORIGINS": { "type": "string", "visibility": "optional", "exposure": "backend-only", "default": "http://localhost:3000", "description": "CSV of allowed CORS origins for backend server" }
  }
}