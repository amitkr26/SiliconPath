{
  "verified": "2026-08-19",
  "opportunity_verification": {
    "initial": "unverified",
    "states": {
      "unverified": {
        "on": { "ADMIN_VERIFY": "verified", "LINK_CHECKER": "link_unavailable", "CLEANUP_CRON": "expired" },
        "description": "Every insert defaults to unverified. Only the admin verify/reject endpoints promote; verify sets verified, reject leaves unverified."
      },
      "verified": {
        "on": { "LINK_CHECKER": "link_unavailable", "CLEANUP_CRON": "expired" },
        "description": "Set by admin verify endpoint"
      },
      "link_unavailable": {
        "on": {},
        "description": "Set by link-checker when the apply link is broken"
      },
      "expired": {
        "on": {},
        "description": "Set by cleanup cron when the deadline passes or the posting closes"
      }
    },
    "notes": "verification_status CHECK constraint on opportunities = verified | unverified | link_unavailable | expired. No pending, no rejected in the enum."
  },
  "connection_request": {
    "initial": "pending",
    "states": {
      "pending": { "on": { "ACCEPT": "accepted", "REJECT": "rejected", "WITHDRAW": "cancelled" }, "description": "Awaiting response" },
      "accepted": { "on": { "DISCONNECT": "cancelled" }, "description": "Connected" },
      "rejected": { "on": {}, "description": "Declined" },
      "cancelled": { "on": {}, "description": "Withdrawn or disconnected" }
    },
    "notes": "connections.status enum = pending | accepted | rejected. No accept-trigger; user_profiles counts maintained by triggers only."
  },
  "application": {
    "initial": "submitted",
    "states": {
      "submitted": { "on": { "REVIEW": "reviewed", "WITHDRAW": "withdrawn" }, "description": "Application submitted" },
      "reviewed": { "on": { "SHORTLIST": "shortlisted", "REJECT": "rejected" }, "description": "Under review" },
      "shortlisted": { "on": { "ACCEPT": "accepted", "REJECT": "rejected" }, "description": "Shortlisted for next round" },
      "accepted": { "on": {}, "description": "Application accepted" },
      "rejected": { "on": {}, "description": "Application rejected" },
      "withdrawn": { "on": {}, "description": "Withdrawn by applicant" }
    }
  },
  "scrape_run": {
    "initial": "queued",
    "states": {
      "queued": { "on": { "START": "running" }, "description": "Waiting to start" },
      "running": { "on": { "COMPLETE": "completed", "FAIL": "failed", "TIMEOUT": "failed" }, "description": "Scraping in progress" },
      "completed": { "on": {}, "description": "Finished successfully" },
      "failed": { "on": { "RETRY": "queued" }, "description": "Finished with errors" }
    }
  }
}