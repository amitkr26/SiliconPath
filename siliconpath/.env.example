# ─────────────────────────────────────────────────────────────────────────────
# SiliconPath env template. Copy to .env.local and fill in real values.
# NEVER commit .env.local. NEVER paste real key values into this file.
# Only NEXT_PUBLIC_* vars are exposed to the browser — keep secrets un-prefixed.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=

# ── db1: Supabase Primary (core transactional: opportunities, news, companies,
#    scraper_sources, user_profiles, auth-linked + community data) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── db2: Supabase Secondary (cold storage: news_archive >30d, overflow logs) ──
SUPABASE_2_URL=
SUPABASE_2_SERVICE_ROLE_KEY=

# ── db3: Neon Primary (analytics & logs: ai_usage_log, scrape_logs, cron_health)
NEON_1_DATABASE_URL=

# ── db4: Neon Secondary (public read replica: opportunities_mirror, news_mirror)
NEON_2_DATABASE_URL=

# ── Scraper / cron auth (server-only) ─────────────────────────────────────────
SCRAPER_SECRET=
CRON_SECRET=

# ── Admin (server-only — intentionally NOT NEXT_PUBLIC_) ───────────────────────
ADMIN_PASSWORD=

# ── AI providers (starter set: 2–3 verified free-tier; expand incrementally) ──
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
