{
  "buildCommand": "npm install && npm run build --workspaces --if-present",
  "outputDirectory": "frontend/.next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/auth/signin",
      "destination": "/login",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/scrapers/run-all",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/news/sync",
      "schedule": "0 6 * * *"
    }
  ]
}
