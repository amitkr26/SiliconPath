{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/check-links",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/send-digest",
      "schedule": "0 8 * * 1"
    }
  ]
}
