{
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/auth/signin",
      "destination": "/login",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/scrapers/run-all",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/news/sync",
      "schedule": "0 6 * * *"
    }
  ]
}
